# Choose a globally unique Google Cloud project ID.
GCP_PROJECT_ID=your-tiller-finance-project
GCP_PROJECT_NAME="Tiller Finance"

# Find this with: gcloud billing accounts list
BILLING_ACCOUNT_ID=000000-000000-000000

# The ID between /d/ and /edit in the Google Sheets URL.
TILLER_SHEET_ID=your-google-sheet-id

# BigQuery settings.
BQ_LOCATION=US
RAW_DATASET=tiller_raw
FINANCE_DATASET=finance
GOLD_DATASET=gold
SYNC_SCHEDULE="every 1 hours"

# Tiller's durable raw balance data is normally in Balance History.
TRANSACTIONS_TAB=Transactions
BALANCE_HISTORY_TAB="Balance History"

# Optional parent for organization-managed Google Cloud accounts.
# GCP_ORGANIZATION_ID=1234567890
# GCP_FOLDER_ID=1234567890

# --- Nightly unattended run (scripts/nightly-sync.sh via launchd) ---
# Path to a service-account JSON key. Set this ONLY in the canonical repo's .env,
# not in worktrees. When present, the nightly job authenticates as the SA instead
# of your user gcloud credential, so it never hits the interactive reauth that
# breaks a 3am run. The SA needs BigQuery admin on this project (datasets, tables,
# jobs, AND the hourly transfer config) and the Tiller sheet must be shared with
# the SA's email so its Drive-backed external tables can be read.
# NIGHTLY_SA_KEY=/Users/stevenjacobs/.config/finance/tiller-sync-key.json

# --- Philly Shows agent (scripts/spotify.py, scripts/shows.py) ---
# Spotify app: https://developer.spotify.com/dashboard
#   Redirect URI (exact): http://127.0.0.1:8888/callback ; API: Web API
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Ticketmaster Discovery: https://developer.ticketmaster.com (Consumer Key)
TICKETMASTER_API_KEY=your-ticketmaster-consumer-key

# Weekly email notifier (scripts/shows_email.py) — dedicated Gmail App Password,
# NOT the repo's send-disabled Gmail OAuth. Create at myaccount.google.com/apppasswords
SHOWS_SMTP_USER=you@gmail.com
SHOWS_SMTP_APP_PASSWORD=your-16-char-app-password
SHOWS_EMAIL_TO=you@gmail.com
