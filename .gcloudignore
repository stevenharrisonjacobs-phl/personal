# Build context for the door image. Everything the Dockerfile does not COPY
# should be excluded — especially anything holding secrets or row-level data.
.git/
.gitignore
.env
.env.example
.context/
__pycache__/
*.py[cod]
.venv/
.secrets/
client_secret*.json

# Repo content the door image does not need.
docs/
projects/
sql/
# scripts/* (not scripts/) so the one file the Dockerfile COPYs can be
# re-included: gitignore syntax cannot negate a path whose PARENT
# directory is excluded, so `scripts/` + `!scripts/x` silently keeps x out
# and the build fails at the COPY with 'file does not exist'.
scripts/*
!scripts/checkin_validate.py
tests/
cowork/
orchestration/
.claude/
.codex/
.cursor/
.agents/
README.md
AGENTS.md
