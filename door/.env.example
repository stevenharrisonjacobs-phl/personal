# personal-door — Cloud Run environment. NEVER commit the filled-in version.
# Secrets belong in Secret Manager and are mounted as env vars at deploy time.

# --- Google OAuth (the connector's login) ---
# Web application client, created in the finance project.
# Publish the consent screen to PRODUCTION — apps left in Testing expire refresh
# tokens after 7 days. These scopes are non-sensitive, so no Google review.
#
# Cloud Run URLs are derived from the project number, so the redirect URI is
# known BEFORE the first deploy — which breaks the otherwise circular
# "need the URL to make the client, need the client to deploy":
#
#   redirect URI:  https://personal-door-513222566024.us-central1.run.app/auth/callback
#
# Confirm it after the first deploy. If Cloud Run assigned the older hash-style
# hostname instead, update the OAuth client's redirect URI and BASE_URL to match.
GOOGLE_OAUTH_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-in-secret-manager
BASE_URL=https://personal-door-513222566024.us-central1.run.app

# --- The perimeter ---
# This door fronts the complete finance mirror on a public URL. This allowlist
# is the ONLY thing between it and the open internet. The door refuses to start
# if this is empty. Add an address only as a deliberate enrollment.
PERSONAL_DOOR_ALLOWED_EMAILS=stevenharrisonjacobs@gmail.com

# --- Persistent encrypted OAuth state ---
# Without these the door refuses to start on a non-loopback BASE_URL: OAuth
# client registrations on ephemeral Cloud Run disk are lost on every cold start,
# which breaks the connector until it is removed and re-added.
# Generate STORAGE_ENCRYPTION_KEY with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SIGNING_KEY=replace-in-secret-manager
STORAGE_ENCRYPTION_KEY=replace-with-fernet-key-in-secret-manager
FIRESTORE_PROJECT=steven-tiller-finance-2026
# FIRESTORE_DATABASE=            # blank = (default)
# FIRESTORE_COLLECTION=personal_door_oauth

# --- BigQuery ---
GCP_PROJECT_ID=steven-tiller-finance-2026
FINANCE_DATASET=finance
GOLD_DATASET=gold

# --- Local development only ---
# Allowed ONLY when BASE_URL is loopback. Never set these on Cloud Run.
# PERSONAL_DOOR_INSECURE_LOCAL=1
# PERSONAL_DOOR_ALLOW_EPHEMERAL_OAUTH=1   # escape hatch; forces reconnect on restart
